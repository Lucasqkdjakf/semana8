import android.os.Bundle
    import android.view.LayoutInflater
    import android.view.View
    import android.view.ViewGroup
    import androidx.fragment.app.Fragment
    import androidx.fragment.app.activityViewModels
    import com.seudominio.app.databinding.FragmentDisplayBinding

    class DisplayFragment : Fragment() {
    private var _binding: FragmentDisplayBinding? = null
    private val binding get() = _binding!!

    // Pega exatamente a mesma instância do ViewModel usada no InputFragment
    private val sharedViewModel: SharedViewModel by activityViewModels()

    override fun onCreateView(inflater: LayoutInflater, container: ViewGroup?, savedInstanceState: Bundle?): View {
    _binding = FragmentDisplayBinding.inflate(inflater, container, false)
    return binding.root
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
    super.onViewCreated(view, savedInstanceState)

    // Observa o dado publicado
    sharedViewModel.projetoAutomotivo.observe(viewLifecycleOwner) { dadoSalvo ->
    binding.tvResultado.text = "Projeto Salvo:\n$dadoSalvo"
    }
    }

    override fun onDestroyView() {
    super.onDestroyView()
    _binding = null
    }
    }